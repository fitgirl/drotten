---
const {
    class: classProp
} = Astro.props

//If you want to change the responsive height of footer:
//tweak the `[--footer-height:${x}]` classes inside of footer component
---

<footer class:list={[
    classProp,
    "[--footer-height:6] h-[calc(var(--block-size)*var(--footer-height))] xs:[--footer-height:5] sm:[--footer-height:4] md:[--footer-height:3] w-full bg-block-bedrock"
]}>
    <div class="flex flex-col sm:flex-row items-center justify-between h-full p-5 bg-dark-75 text-white">
        <header class="flex flex-col gap-3 w-full sm:w-[60%]">
            <span class="font-minecrafter text-2xl text-shadow-lg">M/S DROTTEN</span>
            <p class="text-sm">My personal ferry fan site. Not affiliated with Destination Gotland.</p>
        </header>
        <nav class="self-end flex flex-col items-end gap-1 text-link">
            <a href="https://github.com/BryceRussell/astro-minecraft-theme" class="link">Original theme</a>
            <a href="https://github.com/BryceRussell" class="link">BryceRussell</a>
            <a href="https://astro.build" class="link">Astro</a>
            <a href="/#ms-drotten" class="link">Back to top</a>
        </nav>
    </div>
</footer>

